// Cloudflare Workers static assets. No Worker script: every request is a file from dist/site.
// Workers Builds runs `npm run build`, then `npx wrangler deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // must match the Worker's name in the Cloudflare dashboard
  "name": "gummy-sudoku",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist/site",
  },
}
